{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
   
   "logo": "none",
        
    "display": {
        "constants": [
            "      "
        ]
    },
    "modules": [
        {
            "type": "colors",
            "paddingLeft": 14,
            "symbol": "circle"
        },
        {
            "key": "{$1}Distro",
            "keyColor": "38;5;210",
            "type": "os"
        },
        {
            "key": "{$1}Kernel",
            "keyColor": "38;5;84",
            "type": "kernel"
        },
        {
            "key": "{$1}Shell",
            "keyColor": "38;5;147",
            "type": "shell"
        },
        {
            "key": "{$1}Terminal",
            "keyColor": "38;5;141",
            "type": "terminal"
        },
        {
            "type": "colors",
            "paddingLeft": 14,
            "symbol": "circle"
        },
        {
            "key": "{$1}Paquetes",
            "keyColor": "38;5;200",
            "type": "packages"
        },
        {
            "key": "{$1}WM",
            "keyColor": "38;5;44",
            "type": "wm"
        },
        {
            "key": "{$1}Procesos",
            "keyColor": "38;5;222",
            "type": "processes"
        },
        {
            "type": "colors",
            "paddingLeft": 14,
            "symbol": "circle"
        },
        {
            "key": "{$1}CPU",
            "keyColor": "38;5;75",
            "type": "cpu"
        },
        {
            "key": "{$1}Memoria",
            "keyColor": "38;5;123",
            "type": "memory"
        },
        {
			"key": "{$1}Pantalla",
			"keyColor": "38;5;111",
			"type": "display"
			},
			
			{
            "type": "colors",
            "paddingLeft": 14,
            "symbol": "circle"
        },
        {
            "key": "{$1}Fecha y Hora",
            "keyColor": "38;5;383",
            "type": "datetime"
        },
        {
            "key": "{$1}UpTime",
            "keyColor": "38;5;123",
            "type": "uptime"
        },
        
    ]
}
