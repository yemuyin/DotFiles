{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": "none",
  "display": {
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": false,
    "separator": "  ",
    "color": {
      "keys": "252",
      "title": "195",
      "separator": "59",
      "output": "252"
    },
    "brightColor": true,
    "key": {
      "width": 15
    }
  },
  "modules": [
    { "type": "custom", "format": "         {#@118}  SYSTEM" },
    {
      "type": "title",
      "key": " {#@118} {#@141}User",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "command",
      "key": " {#@118}󰇄 {#@141}Host",
      "text": "hostname",
      "format": "{result}"
    },
    {
      "type": "os",
      "key": " {#@118} {#@141}OS",
      "format": "{pretty-name} [{arch}]"
    },
    {
      "type": "kernel",
      "key": " {#@118} {#@141}Kernel",
      "format": "{release}"
    },
    {
      "type": "command",
      "key": " {#@118}󰅐 {#@141}Uptime",
      "text": "awk '{s=int($1); d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60); printf \"%02dd %02dh %02dm\", d, h, m}' /proc/uptime",
      "format": "{result}"
    },
    "break",
    { "type": "custom", "format": "         {#@81}󱂬  DESKTOP" },
    {
      "type": "de",
      "key": " {#@81}󰧨 {#@208}DE",
      "format": "Niri"
    },
    {
      "type": "wm",
      "key": " {#@81}󱂬 {#@208}WM",
      "format": "Niri (Wayland)"
    },
    {
      "type": "shell",
      "key": " {#@81}󰞷 {#@208}Shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": " {#@81} {#@208}Terminal",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "key": " {#@81}󰍹 {#@208}Display",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "command",
      "key": " {#@81}󰉼 {#@208}Theme",
      "text": "grep -h 'gtk-theme-name' ~/.config/gtk-3.0/settings.ini ~/.gtkrc-2.0 2>/dev/null | head -n1 | cut -d'=' -f2 | tr -d '\" '",
      "format": "{result}"
    },
    {
      "type": "command",
      "key": " {#@81}󰀻 {#@208}Icons",
      "text": "grep -h 'gtk-icon-theme-name' ~/.config/gtk-3.0/settings.ini ~/.gtkrc-2.0 2>/dev/null | head -n1 | cut -d'=' -f2 | tr -d '\" '",
      "format": "{result}"
    },
    {
      "type": "command",
      "key": " {#@81}󰛖 {#@208}Font",
      "text": "grep -h 'gtk-font-name' ~/.config/gtk-3.0/settings.ini ~/.gtkrc-2.0 2>/dev/null | head -n1 | cut -d'=' -f2 | tr -d '\" '",
      "format": "{result}"
    },
    {
      "type": "command",
      "key": " {#@81}󰆿 {#@208}Cursor",
      "text": "grep -h 'gtk-cursor-theme-name' ~/.config/gtk-3.0/settings.ini ~/.gtkrc-2.0 2>/dev/null | head -n1 | cut -d'=' -f2 | tr -d '\" '",
      "format": "{result}"
    },
    "break",
    { "type": "custom", "format": "         {#@178}󰍹  RESOURCES" },
    {
      "type": "cpu",
      "key": " {#@178} {#@69}CPU",
      "format": "{1}"
    },
    {
      "type": "command",
      "key": "   {#@111}Usage",
      "text": "read _ u n s i io irq sirq st g gn < /proc/stat; t1=$((u+n+s+i+io+irq+sirq+st)); id1=$((i+io)); sleep 0.15; read _ u n s i io irq sirq st g gn < /proc/stat; t2=$((u+n+s+i+io+irq+sirq+st)); id2=$((i+io)); dt=$((t2-t1)); did=$((id2-id1)); [ \"$dt\" -le 0 ] && dt=1; p=$((100*(dt-did)/dt)); [ \"$p\" -lt 0 ] && p=0; [ \"$p\" -gt 100 ] && p=100; awk -v p=\"$p\" 'BEGIN {w=16; f=int(p*w/100); bar=\"\"; for (i=1; i<=w; i++) bar=bar ((i<=f) ? \"█\" : \"░\"); lbl=sprintf(\"%03d%%\", p); lblc=sprintf(\"\\033[48;5;59m%s\\033[49m\", lbl); s=int((w-length(lbl))/2)+1; print substr(bar,1,s-1) lblc substr(bar,s+length(lbl));}'",
      "format": "{#@214}󰣙{#@252}  {result}"
    },
    {
      "type": "gpu",
      "key": " {#@178}󰢮 {#@69}GPU",
      "format": "{1} {2}"
    },
    {
      "type": "command",
      "key": " {#@178}󰍛 {#@69}RAM",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\", $3/1024, $2/1024}'",
      "format": "{result}"
    },
    {
      "type": "command",
      "key": "   {#@111}Usage",
      "text": "free | awk 'NR==2{p=int($3*100/$2); w=16; f=int(p*w/100); bar=\"\"; for(i=1;i<=w;i++) bar=bar ((i<=f)?\"█\":\"░\"); lbl=sprintf(\"%03d%%\",p); lblc=sprintf(\"\\033[48;5;59m%s\\033[49m\",lbl); s=int((w-length(lbl))/2)+1; print substr(bar,1,s-1) lblc substr(bar,s+length(lbl))}'",
      "format": "{#@118}󰑭{#@252}  {result}"
    },
    {
      "type": "disk",
      "key": " {#@178}󰋊 {#@69}Disk",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "command",
      "key": "   {#@111}Usage",
      "text": "df -h / | awk 'NR==2{p=int($5); w=16; f=int(p*w/100); bar=\"\"; for(i=1;i<=w;i++) bar=bar ((i<=f)?\"█\":\"░\"); lbl=sprintf(\"%03d%%\",p); lblc=sprintf(\"\\033[48;5;59m%s\\033[49m\",lbl); s=int((w-length(lbl))/2)+1; print substr(bar,1,s-1) lblc substr(bar,s+length(lbl))}'",
      "format": "{#@75}󰋊{#@252}  {result}"
    },
    {
      "type": "battery",
      "key": " {#@178}󰁹 {#@69}Battery",
      "format": "{capacity}% {status}"
    },
    "break",
    { "type": "custom", "format": "         {#@141}󰏗  SOFTWARE" },
    {
      "type": "command",
      "key": "   {#@226}󰮯 {#@193}Xbps",
      "text": "xbps-query -l | wc -l",
      "format": "{#@118}{result}"
    },
    {
      "type": "command",
      "key": "   {#@75}󰏗 {#@193}Flatpak",
      "text": "flatpak list | wc -l",
      "format": "{#@118}{result}"
    },
    {
      "type": "command",
      "key": " {#@141}󰩟 {#@148}Network",
      "text": "iface=$(ip route show default 2>/dev/null | awk 'NR==1 {print $5}'); if [ -n \"$iface\" ]; then ip=$(ip -4 -o addr show dev \"$iface\" scope global 2>/dev/null | awk 'NR==1 {print $4}'); [ -n \"$ip\" ] && printf '%s' \"$ip\" || printf 'n/a'; else printf 'n/a'; fi",
      "format": "{result}"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "printf '\\033[1m\\033[38;5;232m☠ \\033[38;5;52m☠ \\033[38;5;88m☠ \\033[38;5;124m☠ \\033[38;5;160m☠ \\033[38;5;196m☠ \\033[38;5;202m☠ \\033[38;5;208m☠ \\033[38;5;214m☠ \\033[38;5;220m☠ \\033[38;5;214m☠ \\033[38;5;208m☠ \\033[38;5;202m☠ \\033[38;5;196m☠ \\033[38;5;160m☠ \\033[38;5;124m☠ \\033[38;5;88m☠ \\033[38;5;52m☠ \\033[38;5;232m☠\\033[22m\\033[0m'"
    }
  ]
}
