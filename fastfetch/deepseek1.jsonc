{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "modules": [
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "title",
            "key": "User",
            "format": "{user}"
        },
        {
            "type": "title", 
            "key": "Hostname",
            "format": "{host}"
        },
        {
            "type": "host",
            "key": "Model"
        },
        {
            "type": "os",
            "key": "OS",
            "format": "{os}"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime", 
            "key": "Uptime"
        },
        {
            "type": "loadavg",
            "key": "Load Average"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "processes",
            "key": "Processes"
        },
        {
            "type": "wm",
            "key": "Window Manager"
        },
        {
            "type": "de",
            "key": "Desktop Environment"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "cpu",
            "key": "Temperature",
            "temp": true
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ],
    
    // Configuración de colores para los valores
    "color": {
        "title": "blue",
        "os": "green",
        "kernel": "red",
        "uptime": "yellow",
        "loadavg": "magenta",
        "processes": "cyan",
        "wm": "blue",
        "de": "green",
        "shell": "red",
        "terminal": "yellow",
        "packages": "magenta",
        "temperature": "cyan",
        "cpu": "blue",
        "gpu": "green",
        "memory": "red",
        "disk": "yellow"
    }
}