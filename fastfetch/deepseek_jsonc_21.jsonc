{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "title",
            "key": "User",
            "format": "{user-name}"
        },
        {
            "type": "title", 
            "key": "Hostname",
            "format": "{host-name}"
        },
        {
            "type": "host",
            "key": "Model"
        },
        {
            "type": "os",
            "format": "{pretty-name} {version-id} {arch}"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime", 
            "key": "Uptime"
        },
        {
            "type": "loadavg",
            "key": "Load Average"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "processes",
            "key": "Processes"
        },
        {
            "type": "wm",
            "key": "Window Manager"
        },
        {
            "type": "de",
            "key": "Desktop Environment"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "packages",
            "key": "Packages", 
            "format": "{all}"
        },
        {
            "type": "cpu",
            "key": "Temperature",
            "temp": true,
            "format": "{temperature}"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "format": "{cores-logical} x {name}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}