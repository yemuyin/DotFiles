{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "title",
            "key": "\u001b[38;5;33mUser\u001b[0m",
            "format": "{user-name}"
        },
        {
            "type": "title",
            "key": "\u001b[38;5;46mHostname\u001b[0m",
            "format": "{host-name}"
        },
        {
            "type": "host",
            "key": "\u001b[38;5;208mModel\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;5;99mOS\u001b[0m",
            "format": "{pretty-name} {version-id} {arch}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;5;45mKernel\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;5;208mUptime\u001b[0m"
        },
        {
            "type": "loadavg",
            "key": "\u001b[38;5;46mLoad Average\u001b[0m"
        },
        "break", 
        {
            "type": "processes",
            "key": "\u001b[38;5;99mProcesses\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[38;5;33mWindow Manager\u001b[0m"
        },
        {
            "type": "de",
            "key": "\u001b[38;5;45mDesktop Environment\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[38;5;46mShell\u001b[0m"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;5;208mTerminal\u001b[0m",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "packages",
            "key": "\u001b[38;5;99mPackages\u001b[0m",
            "format": "{all}"
        },
        "break",
        {
            "type": "cpu",
            "key": "\u001b[38;5;45mTemperature\u001b[0m", 
            "temp": true,
            "format": "{temperature}"
        },
        {
            "type": "cpu",
            "key": "\u001b[38;5;46mCPU\u001b[0m",
            "format": "{cores-logical} x {name}"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;5;208mGPU\u001b[0m",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "\u001b[38;5;45mRAM\u001b[0m"
        },
        {
            "type": "disk",
            "key": "\u001b[38;5;99mDisk\u001b[0m",
            "folders": "/"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
