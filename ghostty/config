#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#

theme = Aurora

# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
font-family = CaskaydiaCove Nerd Font
font-style=Bold Italic
font-size=12
cursor-style = block
cursor-style-blink = true
cursor-color = ffffff
background-opacity=0.80
#background=000000
#foreground = bbf156
window-padding-balance = true
window-padding-x = 10
window-padding-y = 10
shell-integration = bash
#copy-on-select = clipboard
focus-follows-mouse = false
quit-after-last-window-closed=true

# Atajo para crear una pestaña nueva
keybind = super+t=new_tab

# Atajo para cerrar la pestaña actual
keybind = super+w=close_tab

# (Opcional) Mostrar la barra de pestañas solo cuando haya más de una
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab

# Colores específicos para resaltar la pestaña en foco
#palette = 16=#b87333
#palette = 17=#232136

# Dividir interfaz ---
keybind = ctrl+h=new_split:down
keybind = ctrl+v=new_split:right

# Mover el foco entre divisiones
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom
# Redimensionar paneles
keybind = ctrl+super+left=resize_split:left,5
keybind = ctrl+super+right=resize_split:right,5
keybind = ctrl+super+up=resize_split:up,5
keybind = ctrl+super+down=resize_split:down,5
#Cerrar _Panel
keybind = super+e=close_surface

# Listar temas de color : ghostty +list-themes
# Temas molones : AlienBlood - Hipster Green - Homebrew
