window-close {
    duration-ms 900 // Aumentamos un poco para que se aprecie el carbonizado
    curve "linear"

    custom-shader r"
        float hash(vec2 v) {
            return fract(sin(dot(v, vec2(127.1, 311.7))) * 43758.5453);
        }

        float noise(vec2 v) {
            vec2 i = floor(v);
            vec2 f = fract(v);
            f = f * f * (3.0 - 2.0 * f);
            return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
                       mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
        }

        float fbm(vec2 v) {
            float total = 0.0;
            float amp = 0.5;
            for (int i = 0; i < 5; i++) {
                total += noise(v) * amp;
                v *= 2.5; // Más rugosidad para el carbón
                amp *= 0.5;
            }
            return total;
        }

        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float progress = niri_clamped_progress;
            vec2 uv = coords_geo.xy;

            // Dirección: Abajo -> Arriba
            float vertical_gradient = 1.0 - uv.y; 
            
            // Ruido FBM con más contraste
            float noise_val = fbm(uv * 3.5 + niri_random_seed * 15.0);
            
            // Mezcla de la progresión
            float burn_coord = (vertical_gradient * 0.65 + noise_val * 0.35);
            float threshold = progress * 1.15;

            // 1. Máscara de la ventana (lo que sobrevive)
            float mask = smoothstep(threshold, threshold + 0.02, burn_coord);

            // 2. Zona de Carbón (más ancha que el fuego)
            // Esto oscurece la ventana antes de quemarse
            float char_width = 0.15; // Ancho del carbonizado
            float char_mask = smoothstep(threshold, threshold + char_width, burn_coord);

            // 3. Zona de Brasa Activa (el borde incandescente)
            float fire_width = 0.10; // Ancho del fuego
            float fire_mask = smoothstep(threshold - fire_width, threshold, burn_coord) * (1.0 - mask);

            // Colores: Brasa incandescente
            vec3 fire_color = mix(vec3(0.8, 0.0, 0.0), vec3(1.0, 0.4, 0.0), fire_mask);
            
            // Textura original
            vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
            vec4 color = texture2D(niri_tex, coords_tex.st);

            // Aplicamos carbonizado (oscurecemos el color original donde char_mask es bajo)
            color.rgb *= mix(0.1, 1.0, char_mask); 

            // Aplicamos la máscara de desaparición
            color.rgb *= mask;
            color.a *= mask;
            
            // Sumamos el resplandor de la brasa (potenciado para que brille)
            vec4 burn_edge = vec4(fire_color * fire_mask * 3.5, fire_mask);
            
            return color + (burn_edge * color.a);
        }
    "
}
